function decode(raw){
  const D=[],P=[];let t=Date.parse(raw.start+"T00:00:00Z");const cs=raw.c.split(",");
  for(let i=0;i<cs.length;i++){t+=(raw.d.charCodeAt(i)-48)*864e5;D.push(t);P.push(+cs[i]/100);}
  return {D,P};
}
function idxOf(S,iso){const t=Date.parse(iso+"T00:00:00Z");let lo=0,hi=S.D.length-1;while(lo<hi){const m=(lo+hi)>>1;if(S.D[m]<t)lo=m+1;else hi=m;}return lo;}

// ---- 資產還原引擎（不提領）----
// strat: panic（跌三成全數賣出）| hold（持有不動）| rebound | lump | ladder | dca
function simulate(S,a,b,o,strat,rec){
  const LTV=o.ltv,RATE=o.rate,L=o.add;
  const i0=idxOf(S,a),i1=Math.min(idxOf(S,b),S.P.length-1);
  const p0=S.P[i0];let units=o.S/p0,cash=0,La=0,hi=p0,low=p0;
  let done=new Set(),tr=0,dcaN=0,dcaNext=null,mcOpen=null,mcDays=0,forced=0,peakLoan=0,minGap=null,bought=0;
  let below=false,rest=null;const out=[];
  for(let i=i0;i<=i1;i++){
    const t=S.D[i],p=S.P[i];
    if(i>i0)La*=Math.pow(1+RATE,(t-S.D[i-1])/864e5/365);
    if(p>hi)hi=p;const dd=1-p/hi;if(p<low)low=p;
    if(strat==="panic"&&dd>=0.30&&units>0){cash+=units*hi*0.7;units=0;}
    if(p>=hi&&La>0){const s=Math.min(units,La/p);units-=s;La-=s*p;}
    if(p>=hi){low=p;done=new Set();tr=0;dcaN=0;dcaNext=null;}
    const cr=()=>units*p*LTV;
    const buy=(amt,guard)=>{if(amt<=0)return false;if(guard&&La+amt>0.35*(cr()+amt*LTV))return false;La+=amt;units+=amt/p;bought+=amt;return true;};
    if(strat==="lump"&&dd>=0.30&&!done.has("L")){buy(L,false);done.add("L");}
    if(strat==="ladder"){for(const th of [0.30,0.40,0.50]){if(dd>=th&&!done.has(th)){done.add(th);buy(L/3,true);}}}
    if(strat==="dca"){if(dd>=0.30&&dcaNext===null)dcaNext=t;if(dcaNext!==null&&t>=dcaNext&&dcaN<3){buy(L/3,true);dcaN++;dcaNext=t+182*864e5;}}
    if(strat==="rebound"&&dd>=0.20&&p>=low*1.15&&tr<3){if(buy(L/3,true)){tr++;low=p;}}
    if(La<1e-6)La=0;
    const c=cr();
    if(La>0){if(La>peakLoan)peakLoan=La;const gp=c-La;if(minGap===null||gp<minGap)minGap=gp;
      if(La>c){mcDays++;if(mcOpen===null)mcOpen=t;else if(t-mcOpen>=30*864e5){const x=Math.min(units*p,(La-0.8*c)/(1-0.8*LTV));units-=x/p;La-=x;forced+=x;mcOpen=null;}}
      else mcOpen=null;}
    const net=cash+units*p-La;
    if(net<o.S*0.999)below=true;
    if(below&&rest===null&&net>=o.S)rest=t;
    if(rec&&((i-i0)%5===0||i===i1))out.push({t,net,loan:La,line:c,idx:p/p0});
  }
  return {net:cash+units*S.P[i1]-La,sold:strat==="panic"&&units===0,peakLoan,mcDays,forced,minGap,bought,rest,series:out,t0:S.D[i0],endT:S.D[i1]};
}

