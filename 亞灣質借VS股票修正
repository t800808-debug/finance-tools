function fmt(v){const s=v<0?"−":"";v=Math.abs(v);if(v>=10000){const y=Math.floor(v/10000),w=Math.round(v-y*10000);return s+y+"億"+(w?w.toLocaleString()+"萬":"");}return s+Math.round(v).toLocaleString()+"萬";}
function opts(){return{S:Math.max(1,num("S",0,1e6)),rate:num("R",0,20)/100,ltv:+$("T").value,add:num("L",0,1e6)};}
function yr(t){return new Date(t).getUTCFullYear();}
function ym(t){const d=new Date(t);return `${d.getUTCFullYear()}/${d.getUTCMonth()+1}`;}
function yrs(r){if(r.rest===null)return null;return (r.rest-r.t0)/864e5/365.25;}
function ys(x){if(x===null)return"未還原";if(x<1)return`${Math.max(1,Math.round(x*12))} 個月`;return`${x.toFixed(1)} 年`;}
function epDD(e){const S=DATA[e.m],i0=idxOf(S,e.a),i1=idxOf(S,e.b);let m=S.P[i0];for(let i=i0;i<=i1;i++)m=Math.min(m,S.P[i]);return 1-m/S.P[i0];}
function pill(r){
  if(r.mcDays>0)return'<span class="pill p-bad">曾觸及追繳</span>';
  if(r.bought<=0)return'<span class="pill p-ok">沒有出現加碼訊號</span>';
  return'<span class="pill p-ok">未觸及追繳</span>';
}

function run(){
  const o=opts(),strat=$("M").value;
  // 2 先把霧換成數字
  const low=o.S*0.7,room=low*o.ltv;
  $("kpis").innerHTML=`
    <div class="k"><span>大跌前的投資部位</span><b>${fmt(o.S)}</b><em>可作為質借擔保</em></div>
    <div class="k bad"><span>跌三成之後</span><b>${fmt(low)}</b><em>帳面少了 ${fmt(o.S-low)}</em></div>
    <div class="k hl"><span>要漲多少才回得來</span><b>＋43%</b><em>${fmt(low)} × 1.43 ≈ ${fmt(o.S)}</em></div>
    <div class="k"><span>低點時還可以借</span><b>${fmt(room)}</b><em>${fmt(low)} × 成數 ${Math.round(o.ltv*100)}%；加碼 ${fmt(o.add)}${room>0?`，只用約 ${Math.round(o.add/room*100)}%`:""}</em></div>`;
  $("sell-txt").textContent=`在低點全部賣掉，${fmt(o.S-low)} 的帳面虧損就變成真的虧損。市場之後回來了，帳戶還停在 ${fmt(low)}。`;
  $("hold-txt").textContent=`不賣，等市場回到前高，帳戶就回到 ${fmt(o.S)}。亞灣質借加碼要做的，是讓還原的時間再縮短，而且不必賣掉任何一張股票。`;

  // 3 三種結局
  const cr=CARDS.map(c=>{const e=EP.find(x=>x.id===c.id),S=DATA[e.m];
    return{c,e,panic:simulate(S,e.a,e.b,o,"panic"),hold:simulate(S,e.a,e.b,o,"hold"),pick:simulate(S,e.a,e.b,o,strat)};});
  $("cards").innerHTML=cr.map((r,i)=>`<button type="button" class="sc${i===sel?" on":""}" data-i="${i}" aria-pressed="${i===sel}">
      <span class="tag ${r.c.cls}">${r.c.tag}</span>
      <span class="t1">${r.c.h}</span><span class="t2">例：${r.c.t1}・${r.e.d}</span>
      <span class="act"><b>動作</b>${r.c.act}</span>
      <span class="rows">
        <span class="row bad"><span>低點全數賣出</span><span>停在 ${fmt(r.panic.net)}</span></span>
        <span class="row"><span>持有不動・回到 ${fmt(o.S)}</span><span>${ys(yrs(r.hold))}</span></span>
        <span class="row hl"><span>質借＋${SNAME[strat]}</span><span>${ys(yrs(r.pick))}</span></span>
      </span>
      <span class="big"><span>指數回到前高那天，加碼的帳戶有</span><b>${fmt(r.pick.net)}</b></span>
      <span>${pill(r.pick)}</span>
    </button>`).join("");
  const w=cr[2],hy=yrs(w.hold),py=yrs(w.pick);
  $("cards-note").textContent=(hy!==null&&py!==null&&hy-py>=0.5)
    ?`最壞的結局裡，持有不動要等 ${ys(hy)} 才回到 ${fmt(o.S)}；質借分批加碼只要 ${ys(py)}，早了約 ${Math.round(hy-py)} 年。低點全數賣出的人，三種結局都停在 ${fmt(low)}。`
    :`低點全數賣出的人，三種結局都停在 ${fmt(low)}：市場回來了，資產卻回不來。`;
  document.querySelectorAll(".sc").forEach(b=>b.onclick=()=>{sel=+b.dataset.i;epSel=CARDS[sel].id;run();});

  detail(o,strat);
  table(o,strat);
  bars(o);
}

function fillEps(){
  const g=m=>`<optgroup label="${m==="US"?"美股 S&P 500（1990 年起）":"台股加權指數（1997 年起）"}">`+EP.filter(e=>e.m===m).map(e=>`<option value="${e.id}">${m==="US"?"美股":"台股"} ${e.n}・${e.d}</option>`).join("")+`</optgroup>`;
  $("EPS").innerHTML=g("US")+g("TW");
}
function detail(o,strat){
  const e=EP.find(x=>x.id===epSel)||EP[0];$("EPS").value=e.id;
  const S=DATA[e.m],mk=e.m==="US"?"美股":"台股";
  const endIso=endMode==="now"?NOW_ISO:e.b;
  const sp=simulate(S,e.a,endIso,o,"panic",true),sh=simulate(S,e.a,endIso,o,"hold",true),pk=simulate(S,e.a,endIso,o,strat,true);
  const tRec=S.D[idxOf(S,e.b)],tA=S.D[idxOf(S,e.a)];
  $("d-title").textContent=`走勢細看：${mk} ${e.n}`;
  $("d-sub").textContent=endMode==="now"
    ?`${e.d}。從 ${ym(tA)} 大跌前的高點、${fmt(o.S)} 開始，不提領，同一套規則一路執行到 2026/10/1（之後的大跌照樣加碼）；圖中直虛線是 ${yr(tRec)} 年指數回到前高的時間點。`
    :`${e.d}。從 ${ym(tA)} 大跌前的高點、${fmt(o.S)} 開始，不提領，算到 ${ym(tRec)} 指數回到前高為止。`;
  const pre=endMode==="now"?"到 2026/10/1・":"回到前高時・";
  const gap=pk.peakLoan>0?(pk.minGap>=0?`最接近追繳時，借款離可借上限還有 ${fmt(pk.minGap)}`:`最緊時借款超過可借上限 ${fmt(-pk.minGap)}`):"這段期間沒有出現加碼訊號，沒有借款";
  $("ep-res").innerHTML=`<div class="k bad"><span>${pre}低點全數賣出</span><b>${fmt(sp.net)}</b><em>${sp.sold?"賣掉後就停在這裡":"這段沒跌到三成，未賣出"}</em></div>
    <div class="k"><span>${pre}持有不動</span><b>${fmt(sh.net)}</b><em>回到 ${fmt(o.S)}：${ys(yrs(sh))}</em></div>
    <div class="k hl"><span>${pre}質借＋${SNAME[strat]}</span><b>${fmt(pk.net)}</b><em>回到 ${fmt(o.S)}：${ys(yrs(pk))}</em></div>
    <div class="k"><span>${endMode==="now"?"累計加碼（含之後的大跌）":"加碼金額"}</span><b>${pk.bought>0?fmt(pk.bought):"—"}</b><em>${pk.peakLoan>0?`最高借款（含息）${fmt(pk.peakLoan)}`:"未借款"}</em></div>
    <div class="st">${pill(pk)}<span>${gap}</span></div>`;
  $("lg4").textContent=`質借＋${SNAME[strat]}`;
  lineChart("ch1",[{d:sp.series,k:"net",c:"var(--s1)",w:2},{d:sh.series,k:"net",c:"var(--s3)",w:2.2},{d:pk.series,k:"net",c:"var(--s4)",w:3}],false,endMode==="now"?tRec:null,o.S);
  lineChart("ch2",[{d:pk.series,k:"line",c:"var(--red)",w:2},{d:pk.series,k:"loan",c:"var(--s4)",w:3,fill:true}],true,endMode==="now"?tRec:null);
}
function nice(r){if(r<=0)return 1;const p=Math.pow(10,Math.floor(Math.log10(r))),f=r/p;return(f<=1?1:f<=2?2:f<=5?5:10)*p;}
function lineChart(id,ser,isLoan,mark,base){
  const W=520,H=260,ml=62,mr=12,mt=12,mb=30,iw=W-ml-mr,ih=H-mt-mb;
  const all=ser.flatMap(s=>s.d);const t0=all[0].t,t1=Math.max(...all.map(p=>p.t));
  let mx=Math.max(1,base||0,...ser.flatMap(s=>s.d.map(p=>p[s.k])));let mn=0;
  const st=nice((mx-mn)/4);mx=Math.ceil(mx/st)*st;
  const x=t=>ml+(t-t0)/Math.max(1,t1-t0)*iw,y=v=>mt+(mx-v)/(mx-mn||1)*ih;
  let g="";
  for(let v=mn;v<=mx+1e-6;v+=st)g+=`<line x1="${ml}" x2="${W-mr}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)"/><text x="${ml-6}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)">${fmt(v)}</text>`;
  const y0=yr(t0),y1=yr(t1),span=y1-y0,stp=span>20?5:span>10?3:span>5?2:1;
  for(let Y=y0+1;Y<=y1;Y+=stp){const t=Date.UTC(Y,0,1);if(t<t0||t>t1)continue;g+=`<line x1="${x(t)}" x2="${x(t)}" y1="${mt}" y2="${mt+ih}" stroke="var(--line)" opacity=".6"/><text x="${x(t)}" y="${H-10}" text-anchor="middle" font-size="11" fill="var(--muted)">${Y}</text>`;}
  if(span<1){g+=`<text x="${ml}" y="${H-10}" font-size="11" fill="var(--muted)">${y0} 年</text>`;}
  if(base){g+=`<line x1="${ml}" x2="${W-mr}" y1="${y(base)}" y2="${y(base)}" stroke="var(--gold)" stroke-dasharray="6 4" opacity=".9"/><text x="${W-mr-4}" y="${y(base)-5}" text-anchor="end" font-size="11" fill="var(--gold)">原點 ${fmt(base)}</text>`;}
  if(mark&&mark>t0&&mark<t1){const mx_=x(mark);g+=`<line x1="${mx_}" x2="${mx_}" y1="${mt}" y2="${mt+ih}" stroke="var(--gold)" stroke-dasharray="4 4"/><text x="${mx_+4}" y="${mt+12}" font-size="11" fill="var(--gold)">回到前高</text>`;}
  for(const s of ser){
    const pts=s.d.map(p=>`${x(p.t).toFixed(1)},${y(p[s.k]).toFixed(1)}`).join(" ");
    if(s.fill)g+=`<polygon points="${x(s.d[0].t)},${y(0)} ${pts} ${x(s.d[s.d.length-1].t)},${y(0)}" fill="${s.c}" opacity=".18"/>`;
    g+=`<polyline fill="none" stroke="${s.c}" stroke-width="${s.w}" stroke-linejoin="round" points="${pts}"/>`;
  }
  if(isLoan&&Math.max(...ser[1].d.map(p=>p.loan))<=0)g+=`<text x="${ml+iw/2}" y="${mt+ih/2}" text-anchor="middle" font-size="13" fill="var(--muted)">這段期間沒有借款</text>`;
  $(id).innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${isLoan?"借款與可借上限":"淨資產走勢"}">${g}</svg>`;
}

// 5 每一段大跌算到底
function table(o,strat){
  const list=EP.filter(e=>e.big);
  let h=`<tr><th>大跌（從前高到回到前高）</th><th>低點全數賣出</th><th>持有不動<br>回到 ${fmt(o.S)}</th><th>質借＋加碼<br>回到 ${fmt(o.S)}</th><th>指數回到前高那天<br>加碼的帳戶</th><th>到 2026/10/1<br>加碼／不動</th></tr>`;
  let best=null;
  for(const e of list){
    const S=DATA[e.m],p=simulate(S,e.a,e.b,o,"panic"),hd=simulate(S,e.a,e.b,o,"hold"),pk=simulate(S,e.a,e.b,o,strat);
    const hn=simulate(S,e.a,NOW_ISO,o,"hold"),pn=simulate(S,e.a,NOW_ISO,o,strat);
    const hy=yrs(hd),py=yrs(pk);
    if(hy!==null&&py!==null&&(!best||hy-py>best.d))best={e,d:hy-py,hy,py};
    h+=`<tr><td>${e.m==="US"?"美股":"台股"} ${e.n}<br><span class="note">跌 ${Math.round(epDD(e)*100)}%・${ys((S.D[idxOf(S,e.b)]-S.D[idxOf(S,e.a)])/864e5/365.25)}回到前高</span></td>
      <td class="r">${fmt(p.net)}</td><td>${ys(hy)}</td><td class="g">${ys(py)}${pk.mcDays>0?'<br><span class="pill p-bad">曾觸及追繳</span>':""}</td><td class="g">${fmt(pk.net)}</td>
      <td><b style="color:var(--green)">${fmt(pn.net)}</b><br><span class="note">不動 ${fmt(hn.net)}</span></td></tr>`;
  }
  $("tb").innerHTML=h;
  $("tb-sub").textContent=`資料庫中跌幅超過三成的大跌。每一段都從大跌前的高點、${fmt(o.S)} 股票開始，不提領；加碼方式：${SNAME[strat]}，總額 ${fmt(o.add)}。「到 2026/10/1」為同一套規則繼續執行，之後的大跌照樣加碼，期間加碼借款都已還清。`;
  $("tb-note").textContent=best&&best.d>=0.5?`差距最大的是${best.e.m==="US"?"美股":"台股"} ${best.e.n}：持有不動要 ${ys(best.hy)} 才回到原點，加碼只要 ${ys(best.py)}。低點全數賣出的人，每一段都停在 ${fmt(o.S*0.7)}。`:"";
}

// 6 分批 vs 一次
function bars(o){
  const list=EP.filter(e=>e.big);
  const R=list.map(e=>{const S=DATA[e.m],hd=simulate(S,e.a,e.b,o,"hold"),l=simulate(S,e.a,e.b,o,"lump"),r=simulate(S,e.a,e.b,o,"rebound");return{e,l:l.net-hd.net,r:r.net-hd.net,lm:l.mcDays>0,rm:r.mcDays>0};});
  const mx=Math.max(1,...R.flatMap(x=>[Math.abs(x.l),Math.abs(x.r)]));
  const bar=(v,cls)=>`<span class="bar ${cls}"><i style="width:${Math.max(0.5,Math.abs(v)/mx*100)}%"></i><em>${v>=0?"＋":""}${fmt(v)}</em></span>`;
  $("bars").innerHTML=R.map(x=>`<div class="br"><span class="bn">${x.e.m==="US"?"美股":"台股"} ${x.e.n}</span><span class="bv">${bar(x.l,"l")}${bar(x.r,"r")}</span></div>`).join("");
  const win=R.filter(x=>x.r>x.l).length,sl=R.reduce((s,x)=>s+x.l,0),sr=R.reduce((s,x)=>s+x.r,0);
  $("bars-sub").textContent=`同樣用質借加碼 ${fmt(o.add)}，指數回到前高那天，帳戶比持有不動多出多少。`;
  $("bars-note").textContent=`${R.length} 段大跌裡，分批勝出 ${win} 段；加總起來，分批多 ${fmt(sr)}、一次加碼多 ${fmt(sl)}。一次加碼只在很快回升的時候較好，但大跌當下，沒有人知道會是哪一種。${R.some(x=>x.lm)?"一次加碼在部分段落曾觸及追繳。":""}`;
}

["S","R","L"].forEach(id=>$(id).addEventListener("input",run));
["T","M"].forEach(id=>$(id).addEventListener("change",run));
fillEps();
document.querySelectorAll("#ENDSEG button").forEach(b=>b.onclick=()=>{endMode=b.dataset.e;document.querySelectorAll("#ENDSEG button").forEach(x=>x.classList.toggle("on",x===b));run();});
$("EPS").addEventListener("change",()=>{epSel=$("EPS").value;const i=CARDS.findIndex(c=>c.id===epSel);sel=i;run();});
run();

// ---- 匯出 PDF ----
function toast(msg){const t=$("toast");t.textContent=msg;t.hidden=false;clearTimeout(toast.h);toast.h=setTimeout(()=>t.hidden=true,4000);}
function loadScript(src){return new Promise((ok,no)=>{const s=document.createElement("script");s.src=src;s.onload=ok;s.onerror=()=>no(new Error("load"));document.head.appendChild(s);});}
let libs=null;
function ensureLibs(){if(!libs)libs=Promise.all([
  window.html2canvas?1:loadScript("https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"),
  window.jspdf?1:loadScript("https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js")]).catch(e=>{libs=null;throw e;});return libs;}
let dlP=null;
try{dlP=window.claude&&window.claude.use?window.claude.use("downloads"):null;}catch(e){dlP=null;}
async function buildPdf(){
  await ensureLibs();
  let marks=[];
  const canvas=await html2canvas($("doc"),{scale:2,backgroundColor:"#ffffff",windowWidth:1100,useCORS:true,
    onclone:(d)=>{
      d.documentElement.setAttribute("data-theme","light");d.body.classList.add("exporting");
      const w=d.defaultView,root=d.getElementById("doc"),top=root.getBoundingClientRect().top;
      d.querySelectorAll("svg *").forEach(el=>{for(const at of ["stroke","fill"]){const v=el.getAttribute(at);if(v&&v.includes("var(")){el.setAttribute(at,w.getComputedStyle(el)[at]);}}});
      const blocks=[root.querySelector("header"),...root.querySelectorAll("main > section")];
      const H=root.getBoundingClientRect().height;
      marks=blocks.map(b=>{const r=b.getBoundingClientRect();return[(r.top-top)/H,(r.bottom-top)/H];});
    }});
  const {jsPDF}=window.jspdf;const pdf=new jsPDF({unit:"mm",format:"a4"});
  const PW=210,PH=297,M=10,CW=PW-2*M,pxPerMm=canvas.width/CW,GAP=4*pxPerMm;
  let y=M;
  for(let i=0;i<marks.length;i++){
    let sy=Math.round(marks[i][0]*canvas.height),ey=Math.round(marks[i][1]*canvas.height);
    if(i>0)y+=GAP/pxPerMm;
    while(sy<ey){
      const room=(PH-M-y)*pxPerMm;let h=ey-sy;
      if(h>room){if(y>M+1&&h<=(PH-2*M)*pxPerMm){pdf.addPage();y=M;continue;}h=Math.floor(room);}
      const c=document.createElement("canvas");c.width=canvas.width;c.height=h;c.getContext("2d").drawImage(canvas,0,sy,canvas.width,h,0,0,canvas.width,h);
      pdf.addImage(c.toDataURL("image/jpeg",0.92),"JPEG",M,y,CW,h/pxPerMm);
      y+=h/pxPerMm;sy+=h;
      if(sy<ey){pdf.addPage();y=M;}
    }
  }
  const n=pdf.getNumberOfPages();for(let p=1;p<=n;p++){pdf.setPage(p);pdf.setFontSize(8);pdf.setTextColor(120);pdf.text(`${p} / ${n}`,PW-M,PH-5,{align:"right"});}
  return pdf;
}
async function exportPdf(){
  const btn=$("pdf");btn.disabled=true;const old=btn.textContent;btn.textContent="產生中…";
  try{
    const pdf=await buildPdf();
    const d=new Date(),pz=x=>String(x).padStart(2,"0"),fn=`資產還原試算_${d.getFullYear()}${pz(d.getMonth()+1)}${pz(d.getDate())}.pdf`;
    const dl=dlP?await dlP:null;
    if(dl){
      try{await dl.save({filename:fn,data:pdf.output("blob")});toast("PDF 已匯出");}
      catch(e){if(e&&e.code==="declined")toast("已取消匯出");else if(e&&e.code==="rate_limited")toast("已有一個存檔視窗開著，請先完成或關閉它");else toast("此處無法存檔，請在瀏覽器分頁中開啟本頁再試");}
    }else{pdf.save(fn);}
  }catch(e){toast("PDF 產生失敗，請確認網路連線後再試一次");}
  finally{btn.disabled=false;btn.textContent=old;}
}
$("pdf").addEventListener("click",exportPdf);


</script>

