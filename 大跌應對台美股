  const D=DATA[mk];let i0=D.dt.indexOf(toT(start));if(i0<0)i0=D.dt.findIndex(t=>t>=toT(start));
  const peak=D.px[i0];const S0=o.pos/peak;let extra=0,loan=0,prevT=D.dt[i0];
  const per=o.mode==="once"?o.amt:o.amt/o.nb;const nmax=o.mode==="once"?1:o.nb;
  let n=0,tracking=false,low=null,buys=[],skipped=0;let minR=Infinity,minRi=-1;let minNet=Infinity,holdMin=Infinity,trough=Infinity,troughI=i0;
  let restore=null,holdRestore=null,repay=null,call=null,path=[];
  for(let i=i0;i<D.px.length;i++){
    const p=D.px[i],t=D.dt[i];
    if(loan>0)loan*=Math.pow(1+o.rate,(t-prevT)/365);prevT=t;
    if(p<trough){trough=p;troughI=i;}
    const dd=1-p/peak;
    const tryBuy=()=>{const coll=(S0+extra)*p;if(loan+per>o.ltv*coll+1e-9){skipped++;return false;}extra+=per/p;loan+=per;n++;buys.push({i,t,p,lvl:p/peak});return true;};
    if(n<nmax&&!repay){
      if(o.mode==="once"){if(dd>=o.drop){if(!tryBuy())n=1;}}
      else if(o.mode==="ladder"){while(n<nmax&&dd>=o.drop+n*o.step-1e-12){if(!tryBuy()){n++;}}}
      else{
        if(!tracking&&dd>=o.drop){tracking=true;low=p;}
        if(tracking){if(p<low)low=p;if(p>=low*(1+o.reb)&&dd>=o.drop){tryBuy();low=p;}}
      }
    }
    const sh=S0+extra,coll=sh*p,net=coll-loan;
    if(loan>0){const r=coll/loan;if(r<minR){minR=r;minRi=i;}if(coll*o.ltv<loan&&!call)call={i,t,p};}
    if(net<minNet)minNet=net;if(S0*p<holdMin)holdMin=S0*p;
    path.push([t,p/peak,loan>0?loan/(o.ltv*sh)/peak:null]);
    if(!restore&&i>i0&&net>=o.pos-1e-6)restore=t;
    if(!holdRestore&&i>i0&&S0*p>=o.pos-1e-6)holdRestore=t;
    if(i>i0&&p>=peak){
      if(loan>0){extra-=loan/p;loan=0;}
      repay={t,acct:(S0+extra)*p,hold:S0*p};break;
    }
  }
  const last=D.px.length-1;
  const endI=repay?D.dt.indexOf(repay.t):last;
  return {start:D.dt[i0],peak,maxDD:1-trough/peak,troughT:D.dt[troughI],buys,skipped,n:buys.length,minR:minR===Infinity?null:minR,minRT:minRi>=0?D.dt[minRi]:null,
    buffer:minR===Infinity?null:1-1/(o.ltv*minR),call,restore,holdRestore,repay,ongoing:!repay,
    now:repay?null:{acct:(S0+extra)*D.px[last]-loan,hold:S0*D.px[last],loan,t:D.dt[last],dd:1-D.px[last]/peak},minNet,holdMin,path};
}
function opts(){const g=id=>+document.getElementById(id).value;
  return {mk:state.mk,mode:state.mode,pos:g("pos"),amt:Math.max(0,g("amt")),nb:Math.max(1,Math.round(g("nb"))),drop:g("drop")/100,reb:g("reb")/100,step:g("step")/100,ltv:g("ltv")/100,rate:g("rate")/100};}
function maxSafe(o){
  // largest amount (step 10萬) with no margin call in any episode of this market
  const ok=a=>EPI[o.mk].every(([s])=>{const r=sim(o.mk,s,{...o,amt:a});return !r.call&&!r.skipped;});
  if(!ok(10))return 0;let lo=10,hi=o.pos*3;if(ok(hi))return hi;
  while(hi-lo>10){const m=Math.round((lo+hi)/2/10)*10;if(m===lo||m===hi)break;if(ok(m))lo=m;else hi=m;}
  return lo;
}
const state={mk:"TW",mode:"rebound",sel:null};
function render(){
  const o=opts();
  document.getElementById("fReb").style.display=o.mode==="rebound"?"":"none";
  document.getElementById("fStep").style.display=o.mode==="ladder"?"":"none";
  document.getElementById("fBatches").style.display=o.mode==="once"?"none":"";
  document.getElementById("lDrop").textContent=o.mode==="rebound"?"從高點跌多少開始記錄低點（%）":o.mode==="ladder"?"跌多少買第一批（%）":"跌多少一次買進（%）";
  document.getElementById("modeHint").textContent=o.mode==="rebound"?"不猜底部：跌到設定幅度後，每次等市場從低點反彈才買一批。":o.mode==="ladder"?"跌到設定幅度買第一批，之後每多跌一段再買一批。":"第一次跌到設定幅度時，把加碼金額一次買完。";
  const eps=EPI[o.mk].map(([s,name])=>({name,s,...sim(o.mk,s,o)}));
  // table
  let h=`<tr><th>大跌</th><th class="r">最大跌幅</th><th>加碼買進</th><th class="r">最緊的時候<br>擔保品÷借款</th><th>會不會追繳</th><th class="r">回到高點時帳戶<br>不加碼 → 加碼</th><th class="r">資產還原<br>不動 → 加碼</th></tr>`;
  for(const e of eps){
    const buys=e.n?`${e.n} 批，平均在高點的 ${Math.round(e.buys.reduce((a,b)=>a+b.lvl,0)/e.n*100)}%`+(e.skipped?`<div class="small">${e.skipped} 批因額度不足略過</div>`:""):(`<span class="small">未觸發</span>`);
    const ratio=e.minR?`${e.minR.toFixed(1)} 倍<div class="small">${ym(e.minRT)}</div>`:"—";
    const mc=!e.n?`<span class="pill na">未借款</span>`:e.call?`<span class="pill bad">會，${ds(e.call.t)}</span>`:`<span class="pill good">不會</span><div class="small">還能再跌 ${Math.round(e.buffer*100)}%</div>`;
    let res,rt;
    if(e.repay){res=`${fm(e.repay.hold)} → <b>${fm(e.repay.acct)}</b> 萬`;rt=`${yr(e.holdRestore-e.start)} 年 → <b>${e.restore?yr(e.restore-e.start):"—"} 年</b>`;}
    else{res=`<span class="small">尚未回到高點（目前跌 ${Math.round(e.now.dd*100)}%）</span><div>${fm(e.now.hold)} → <b>${fm(e.now.acct)}</b> 萬</div>`;rt=`<span class="small">進行中</span>`;}
    h+=`<tr class="row${state.sel===e.s?" sel":""}" data-s="${e.s}"><td><b>${MK[o.mk]} ${e.name}</b><div class="small">${ym(e.start)} 起</div></td><td class="r">−${Math.round(e.maxDD*100)}%</td><td>${buys}</td><td class="r">${ratio}</td><td>${mc}</td><td class="r">${res}</td><td class="r">${rt}</td></tr>`;
  }
  const tb=document.getElementById("tbl");tb.innerHTML=h;
  tb.querySelectorAll("tr.row").forEach(r=>r.onclick=()=>{state.sel=r.dataset.s;render();});
  // summary
  const used=eps.filter(e=>e.n>0), calls=eps.filter(e=>e.call);
  const deepest=eps.reduce((a,b)=>b.maxDD>a.maxDD?b:a);
  const tight=used.length?used.reduce((a,b)=>b.minR<a.minR?b:a):null;
  const done=eps.filter(e=>e.repay&&e.n>0);
  const gain=done.reduce((a,e)=>a+(e.repay.acct-e.repay.hold),0);
  const safe=maxSafe(o);
  let c="";
  c+=`<div class="card ${calls.length?"warn":""}"><div class="k">歷史 ${eps.length} 段大跌中，被追繳</div><div class="v">${calls.length} 段</div><div class="d">${calls.length?"："+calls.map(e=>e.name).join("、"):"每一段都沒有收到補錢通知"}</div></div>`;
  c+=tight?`<div class="card"><div class="k">最緊的一次：${MK[o.mk]} ${tight.name}</div><div class="v">${tight.minR.toFixed(1)} 倍</div><div class="d">${tight.call?"已低於追繳門檻":`擔保品是借款的 ${tight.minR.toFixed(1)} 倍，股價再跌約 ${Math.round(tight.buffer*100)}% 才會追繳`}</div></div>`:`<div class="card"><div class="k">目前設定</div><div class="v">未加碼</div><div class="d">歷史上沒有一段跌到觸發條件</div></div>`;
  c+=`<div class="card navy"><div class="k">照這套買法，歷史最壞也不追繳的加碼上限</div><div class="v">${fm(safe)} 萬</div><div class="d">每一批都買得到、也不會被追繳。您設定 ${fm(o.amt)} 萬，約為上限的 ${safe?Math.round(o.amt/safe*100):"—"}%${safe&&o.amt>safe?"，已超過上限":""}</div></div>`;
  c+=`<div class="card"><div class="k">有加碼的 ${done.length} 段，回到高點時合計多出</div><div class="v">${gain>=0?"+":""}${fm(gain)} 萬</div><div class="d">相較持有不動、不加碼</div></div>`;
  document.getElementById("cards").innerHTML=c;
  document.getElementById("concl").innerHTML=`${MK[o.mk]}最深的一次是 <b>${deepest.name}</b>（跌 ${Math.round(deepest.maxDD*100)}%）。照您的設定加碼 ${fm(o.amt)} 萬，`+(calls.length?`<b style="color:var(--warn)">歷史上有 ${calls.length} 段會被追繳</b>，建議調低加碼金額或改用分批。`:`<b>歷史上每一段都不會被追繳</b>；最緊的時候股價還能再跌約 ${tight?Math.round(tight.buffer*100):"—"}%。`);
  // chart
  const sel=eps.find(e=>e.s===state.sel)||deepest;state.sel=sel.s;
  document.querySelectorAll("tr.row").forEach(r=>r.classList.toggle("sel",r.dataset.s===sel.s));
  drawChart(sel,o);
}
function drawChart(e,o){
  const W=1000,H=360,L=56,R=16,T=16,B=36;const P=e.path;
  const t0=P[0][0],t1=P[P.length-1][0];
  let ymin=Math.min(...P.map(q=>Math.min(q[1],q[2]??9))),ymax=Math.max(1.02,...P.map(q=>q[1]));ymin=Math.max(0,Math.floor(ymin*10)/10-0.05);
  const x=t=>L+(t-t0)/(t1-t0||1)*(W-L-R), y=v=>T+(ymax-v)/(ymax-ymin)*(H-T-B);
  const step=Math.max(1,Math.floor(P.length/700));
  let dIdx="",dCall="";let pen=false;
  P.forEach((q,k)=>{if(k%step&&k!==P.length-1)return;dIdx+=(k?"L":"M")+x(q[0]).toFixed(1)+" "+y(q[1]).toFixed(1);
    if(q[2]!=null){dCall+=(pen?"L":"M")+x(q[0]).toFixed(1)+" "+y(Math.max(q[2],ymin)).toFixed(1);pen=true;}else pen=false;});
  let g="";
  for(let v=Math.ceil(ymin*10)/10;v<=ymax+1e-9;v+=0.1){g+=`<line x1="${L}" x2="${W-R}" y1="${y(v)}" y2="${y(v)}" stroke="#E4DED0"/><text x="${L-8}" y="${y(v)+4}" font-size="12" fill="#7A8291" text-anchor="end">${Math.round(v*100)}</text>`;}
  const yrs=[];const y0=new Date(BASE+t0*DAY).getUTCFullYear(),y1=new Date(BASE+t1*DAY).getUTCFullYear();const ys=Math.max(1,Math.ceil((y1-y0+1)/10));
  for(let yy=y0;yy<=y1+1;yy+=ys){const t=(Date.UTC(yy,0,1)-BASE)/DAY;if(t>=t0&&t<=t1)g+=`<text x="${x(t)}" y="${H-12}" font-size="12" fill="#7A8291" text-anchor="middle">${yy}</text><line x1="${x(t)}" x2="${x(t)}" y1="${H-B}" y2="${H-B+5}" stroke="#7A8291"/>`;}
  if(t1-t0<400){for(let k=0;k<P.length;k+=Math.max(1,Math.floor(P.length/6))){g+=`<text x="${x(P[k][0])}" y="${H-12}" font-size="12" fill="#7A8291" text-anchor="middle">${ym(P[k][0])}</text>`;}}
  let dots="";for(const b of e.buys)dots+=`<circle cx="${x(b.t)}" cy="${y(b.lvl)}" r="6" fill="#C9A253" stroke="#0F2A4A" stroke-width="1.5"><title>${ds(b.t)} 買進，指數在高點的 ${Math.round(b.lvl*100)}%</title></circle>`;
  if(e.repay)dots+=`<circle cx="${x(e.repay.t)}" cy="${y(1)}" r="6" fill="#2F6B4F"><title>${ds(e.repay.t)} 回到高點，還清借款</title></circle>`;
  if(e.call)dots+=`<circle cx="${x(e.call.t)}" cy="${y(e.call.p/e.peak)}" r="7" fill="none" stroke="#A33B2B" stroke-width="2.5"><title>${ds(e.call.t)} 觸及追繳</title></circle>`;
  document.getElementById("chart").innerHTML=`<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="${e.name} 指數走勢與追繳線">${g}<line x1="${L}" x2="${W-R}" y1="${y(1)}" y2="${y(1)}" stroke="#C9A253" stroke-dasharray="2 4"/><path d="${dIdx}" fill="none" stroke="#0F2A4A" stroke-width="2"/>${dCall?`<path d="${dCall}" fill="none" stroke="#A33B2B" stroke-width="2" stroke-dasharray="6 4"/>`:""}${dots}</svg>`;
  document.getElementById("chTitle").textContent=`4　走勢圖：${MK[o.mk]} ${e.name}`;
  const gap=e.minR?`最接近追繳線的時候是 ${ym(e.minRT)}，指數再跌約 ${Math.round(e.buffer*100)}% 才會碰到紅色虛線。`:"這一段沒有借款。";
  document.getElementById("chSub").textContent=`指數最多跌到高點的 ${Math.round((1-e.maxDD)*100)}%。紅色虛線越低、離深藍線越遠，越安全。${e.call?"這一段指數跌破了追繳線。":gap}`;
}
document.querySelectorAll(".seg").forEach(sg=>sg.addEventListener("click",ev=>{const b=ev.target.closest("button");if(!b)return;sg.querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));if(sg.id==="mkt"){state.mk=b.dataset.v;state.sel=null;}else state.mode=b.dataset.v;render();}));
document.querySelectorAll("input").forEach(el=>el.addEventListener("input",()=>render()));
render();
</script>
